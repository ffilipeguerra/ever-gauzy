# Modelo do .env do Gauzy na VPS. Copie para .env NA VPS e rode ./gerar-segredos.sh,
# que preenche as senhas e os segredos ali mesmo. Nenhum segredo entra no Git nem no chat.

# --- Traefik (confirmar na VPS antes de subir; ver README) -----------------------
GAUZY_DOMINIO=gauzy.exemplo.com.br
TRAEFIK_REDE=CONFIRMAR
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=CONFIRMAR

# --- Imagens, fixadas pelo digest (ghcr.io/ever-co, linux/amd64, 29/10/2026) --------
GAUZY_API_DIGEST=sha256:ffa2be9beae4171fb2f954b053d6b256cd10bd612b446b72032495052e1c3d8e
GAUZY_WEBAPP_DIGEST=sha256:9757fbe2a198e8289ef00a384179bf0239aa5ca002a2db1feda850ae733d02e0

# --- Aplicação --------------------------------------------------------------------
NODE_ENV=production
DEMO=false
IS_DOCKER=true
APP_NAME=SGQ Triagem
API_HOST=api
API_PORT=3000
WEB_HOST=webapp
WEB_PORT=4200
# O navegador fala só com o domínio; o nginx da tela repassa /api/ para a API.
API_BASE_URL=https://gauzy.exemplo.com.br
CLIENT_BASE_URL=https://gauzy.exemplo.com.br
ALLOWED_ORIGINS=https://gauzy.exemplo.com.br
# A API só é alcançada pelo nginx da tela (nenhuma porta publicada): um salto.
TRUST_PROXY=1
ALLOW_SUPER_ADMIN_ROLE=true
DEFAULT_CURRENCY=BRL
DEFAULT_COUNTRY=BR

# --- Banco ------------------------------------------------------------------------
DB_ORM=typeorm
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=gauzy
DB_USER=gauzy
DB_PASS=
DB_SYNCHRONIZE=false
DB_LOGGING=error
DB_POOL_SIZE=20
DB_POOL_SIZE_KNEX=5
DB_SSL_MODE=false

# --- Sem Redis e sem worker separado: a própria API roda as rotinas -----------------
REDIS_ENABLED=false
WORKER_QUEUE_ENABLED=false
WORKER_SCHEDULER_ENABLED=false
FILE_PROVIDER=LOCAL

# --- Segredos: preenchidos por gerar-segredos.sh -------------------------------------
JWT_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_VERIFICATION_TOKEN_SECRET=
EXPRESS_SESSION_SECRET=
JWT_TOKEN_EXPIRATION_TIME=86400
JWT_REFRESH_TOKEN_EXPIRATION_TIME=604800
JWT_VERIFICATION_TOKEN_EXPIRATION_TIME=604800

# --- Contas criadas no primeiro boot (a API recusa subir com as senhas padrão) -------
DEMO_SUPER_ADMIN_EMAIL=
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_EMAIL=
DEMO_EMPLOYEE_PASSWORD=

THROTTLE_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=6000
